---
import Logo from './Logo.astro';
import { COMPANY, EMAIL, PRODUCT, productPath } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <a href="/" class="footer-logo"><Logo height={20} /></a>
    <nav aria-label="Footer">
      <ul>
        <li><a href="/privacy/">Privacy</a></li>
        {
          PRODUCT.enabled && (
            <>
              <li><a href={productPath('support')}>{PRODUCT.name} support</a></li>
              <li><a href={productPath('privacy')}>{PRODUCT.name} privacy</a></li>
            </>
          )
        }
        <li><a href={`mailto:${EMAIL.hello}`}>{EMAIL.hello}</a></li>
      </ul>
    </nav>
    <p class="legal">
      {COMPANY.legalName}. Registered in {COMPANY.jurisdiction}, company number {COMPANY.number}.
      Registered office: {COMPANY.registeredOffice}.
    </p>
    <p class="copy">&copy; {year} {COMPANY.legalName}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-muted);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .inner {
    padding-block: 2.5rem 3rem;
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: 1.75rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--ink);
    font-weight: 500;
  }

  .legal {
    max-width: 44rem;
    margin-bottom: 0.5rem;
  }

  .copy {
    margin: 0;
  }
</style>
